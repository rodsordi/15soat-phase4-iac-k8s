{
  "name": "Phase 4 - Persistencia Poliglota (PostgreSQL HikariCP & MongoDB)",
  "description": "Monitoramento dedicado do pool de conexoes HikariCP (Work Order e Billing) e do driver MongoDB (Exec)",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Database Pools & Latencia",
      "widgets": [
        {
          "title": "PostgreSQL / HikariCP - Conexoes Ativas vs Ociosas",
          "layout": { "column": 1, "row": 1, "width": 6, "height": 4 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT average(hikaricp.connections.active) AS 'Ativas', average(hikaricp.connections.idle) AS 'Ociosas', average(hikaricp.connections.pending) AS 'Aguardando' FROM Metric WHERE metricName LIKE 'hikaricp.connections%' TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "PostgreSQL / HikariCP - Duracao de Aquisicao de Conexoes (ms)",
          "layout": { "column": 7, "row": 1, "width": 6, "height": 4 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT average(hikaricp.connections.acquire * 1000) AS 'Media (ms)', percentile(hikaricp.connections.acquire * 1000, 95) AS 'p95 (ms)' FROM Metric WHERE metricName = 'hikaricp.connections.acquire' TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "HikariCP - Timeouts de Conexao (24h)",
          "layout": { "column": 1, "row": 5, "width": 4, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT latest(hikaricp.connections.timeout) AS 'Timeouts' FROM Metric WHERE metricName = 'hikaricp.connections.timeout' SINCE 24 hours ago"
              }
            ]
          }
        },
        {
          "title": "HikariCP - Conexoes Ativas Atuais",
          "layout": { "column": 5, "row": 5, "width": 4, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT latest(hikaricp.connections.active) AS 'Conexoes Ativas' FROM Metric WHERE metricName = 'hikaricp.connections.active'"
              }
            ]
          }
        },
        {
          "title": "Erros de Persistencia em Logs (PostgreSQL / MongoDB) (24h)",
          "layout": { "column": 9, "row": 5, "width": 4, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "SELECT count(*) AS 'Erros de BD' FROM Log WHERE namespaceName = '${workload_namespace}' AND (message LIKE '%SQLException%' OR message LIKE '%MongoException%' OR message LIKE '%DataAccessResourceFailureException%') SINCE 24 hours ago"
              }
            ]
          }
        }
      ]
    }
  ]
}
